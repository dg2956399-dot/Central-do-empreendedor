:root {
  --navy: #082D63;
  --blue: #0754B8;
  --light-blue: #EAF3FF;
  --white: #FFFFFF;
  --text: #172B4D;
  --muted: #64748B;
  --background: #F6F8FC;
  --border: #E4EAF2;
  --green: #16A36A;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: Arial, Helvetica, sans-serif;
  background: var(--background);
  color: var(--text);
  line-height: 1.6;
}

button, input {
  font: inherit;
}

button {
  cursor: pointer;
}

a {
  text-decoration: none;
  color: inherit;
}

.container {
  width: 90%;
  max-width: 1200px;
  margin: auto;
}

.btn {
  display: inline-block;
  padding: 12px 22px;
  border: none;
  border-radius: 9px;
  background: var(--blue);
  color: white;
  font-weight: bold;
}

.btn:hover {
  background: var(--navy);
}

.card {
  background: white;
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 24px;
}

input {
  width: 100%;
  padding: 13px;
  border: 1px solid var(--border);
  border-radius: 8px;
  outline-color: var(--blue);
}
